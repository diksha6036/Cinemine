# Backend only. Use your TMDB "API Read Access Token" from account settings.
# Never prefix this with VITE_ and never put credentials in public/.
TMDB_READ_ACCESS_TOKEN=

# Alternatively, a TMDB v3 API key can be used instead of a Read Access Token.
# TMDB_API_KEY=

# Public canonical origin, once the permanent domain is ready (e.g. https://your-domain).
# Set the SAME value on Vercel and Netlify. Leave blank to use the request host.
SITE_URL=
