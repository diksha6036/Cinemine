{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    },
    "api/pages.js": {
      "maxDuration": 60,
      "includeFiles": "{dist/index.html,dist-ssr/**}"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/pages?_path=/"
    },
    {
      "src": "^/index[.]html$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/(calendar|sitemap|where-to-watch)/?$",
      "dest": "/api/pages?_path=/$1"
    },
    {
      "src": "^/movie/([^/]+)/?$",
      "dest": "/api/pages?_path=/movie/$1"
    },
    {
      "src": "^/(robots[.]txt|sitemap(?:-pages|-movies)?[.]xml)$",
      "dest": "/api/pages?_path=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/.*$",
      "status": 404
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/pages?_path=/$1"
    }
  ]
}
